        <!-- ===================== NOTES ===================== -->
        <mxCell id="note1" value="§2.3 Residency — EU-classified customer data has exactly ONE copy, in West Europe. The DR region holds no copy at all, so residency is provable by absence rather than by a standing negative-proof burden at four unannounced audits a year." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontColor=#1F4F1F;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="sub">
          <mxGeometry x="30" y="1440" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="§4.3 Availability — a zone-redundant SINGLE active region lands at our standard 99.95% Enterprise tier. This design structurally CANNOT reach 99.99%, and any SLA miss of any duration triggers immediate termination plus a full refund of that month's fees." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontColor=#6B1F1C;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="sub">
          <mxGeometry x="560" y="1440" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="DR posture — warm standby, promoted by runbook: manual RTO. Async replication gives RPO ~15 min for non-EU-classified tables only. Optimised for §2.2 scale at the lowest defensible cost (20% TCO) and the fastest §7 timeline — the benchmarked single-region topology." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#6B5200;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="sub">
          <mxGeometry x="1090" y="1440" width="480" height="90" as="geometry" />
        </mxCell>

